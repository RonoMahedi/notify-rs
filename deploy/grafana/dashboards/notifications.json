    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(notifications_processed_total{outcome=\"sent\"}[$__rate_interval])) / clamp_min(sum(rate(notifications_processed_total{outcome=~\"sent|dlq\"}[$__rate_interval])), 1e-9)",
